# Copy this file to ".env" (same folder) and fill in your keys.
# Never commit the real .env file.

# --- Pinecone (https://app.pinecone.io -> API Keys) ---
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=nic-2025
PINECONE_NAMESPACE=nic-2025
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- Groq (https://console.groq.com/keys) ---
GROQ_API_KEY=your_groq_api_key_here
# Llama 3.1 8B / 3.3 70B were retired by Groq on 16 Aug 2026.
# Fast + cheap (default):  openai/gpt-oss-20b
# Higher quality:          openai/gpt-oss-120b
# Current list: https://console.groq.com/docs/models
GROQ_MODEL=your_groq_model_here
# These models use part of the budget for reasoning, so keep this generous
GROQ_MAX_TOKENS=1500

# --- Embeddings (leave as-is; the index dimension must be 384) ---
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# --- Server ---
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Limit CPU threads used by PyTorch (helps on small laptops)
TORCH_NUM_THREADS=2
